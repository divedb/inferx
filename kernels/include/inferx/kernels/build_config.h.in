#ifndef INFERX_KERNELS_BUILD_CONFIG_H_
#define INFERX_KERNELS_BUILD_CONFIG_H_

#define INFERX_KERNELS_HAS_CUDA @INFERX_KERNELS_BUILD_HAS_CUDA @
#define INFERX_KERNELS_HAS_ROCM @INFERX_KERNELS_BUILD_HAS_ROCM @
#define INFERX_KERNELS_HAS_ASCEND @INFERX_KERNELS_BUILD_HAS_ASCEND @

namespace inferx::kernels {

/// \brief True when the CUDA backend is compiled into this build
///        (`INFERX_ENABLE_CUDA=ON`).
inline constexpr bool kHasCuda = INFERX_KERNELS_HAS_CUDA != 0;

/// \brief True when the ROCm/HIP backend is compiled into this build
///        (`INFERX_ENABLE_ROCM=ON`).
inline constexpr bool kHasRocm = INFERX_KERNELS_HAS_ROCM != 0;

/// \brief True when the Ascend backend is compiled into this build
///        (`INFERX_ENABLE_ASCEND=ON`).
inline constexpr bool kHasAscend = INFERX_KERNELS_HAS_ASCEND != 0;

}  // namespace inferx::kernels

#endif  // INFERX_KERNELS_BUILD_CONFIG_H_
