Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-avoid-goto,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-pro-type-const-cast,
  google-build-explicit-make-pair,
  google-build-namespaces,
  google-explicit-constructor,
  modernize-use-nullptr,
  performance-*,
  portability-*
WarningsAsErrors: '*'
# CMake passes absolute paths, so anchor on the project-relative directory
# names rather than the start of the string.
HeaderFilterRegex: '(^|/)(include|src|apps|tests|benchmarks|platform)/'
FormatStyle: file
