# Build trees (see CMakePresets.json: everything generated lives under out/).
out/
build*/
cmake-build-*/

# Local CMake presets and compile databases are developer-machine specific.
CMakeUserPresets.json
compile_commands.json
compile_flags.txt

# Profiler and sanitizer outputs.
*.prof
*.profraw
callgrind.out.*
perf.data*
core

# Python developer tooling caches.
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/

# Editor and OS noise.
.idea/
.vscode/
*.swp
.DS_Store
tools/bench/tokenspeed/
bench-venv/
.zcode

# Tokenizer vendor package: cargo build tree (the crate closure is vendored;
# the staticlib is built into out/ via --target-dir).
third_party/tokenizer/rust/target/
# Tokenizer differential-corpus generation environment (tooling only).
out/fixtures-venv/
