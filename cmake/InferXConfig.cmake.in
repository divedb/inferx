@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Dependencies of installed InferX targets. M0's `inferx::base` is
# self-contained; when M1 exposes absl::Status through public headers, add
#   find_dependency(absl CONFIG)
# here and require the pinned Abseil package in the same prefix (proven by
# tests/consumer_absl).

include("${CMAKE_CURRENT_LIST_DIR}/InferXTargets.cmake")

check_required_components(InferX)
